# Copy to .env.local and fill in. .env* is gitignored — the real key never
# lands in the repo; set the same three vars in the host's dashboard on deploy.

# https://resend.com/api-keys
RESEND_API_KEY=

# Must be on a domain verified in Resend, otherwise the send is rejected.
CONTACT_FROM="FrameFlow Contact <contact@frameflow.ca>"

# Comma-separated list of recipients.
CONTACT_TO=
